{
  "name": "rl-stat-tracker",
  "version": "0.3.15",
  "private": true,
  "scripts": {
    "setup": "node tools/fetch-rrrocket.mjs && cd server && npm install && cd ../client && npm install && npm run build",
    "start": "cd server && node src/index.js --open",
    "import": "cd server && node src/cli-import.js",
    "build": "cd client && npm run build",
    "benchmark:download": "node tools/benchmark-download.mjs",
    "publish-models": "node tools/publish-models.mjs",
    "test": "node --test server/test/rating.test.js server/test/golden.test.js",
    "golden:update": "node tools/update-golden.mjs"
  }
}
